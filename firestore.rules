rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Business private data ───────────────────────────────────────────────
    // ONLY the authenticated owner can read or write their business data.
    // Customers never touch this collection directly.
    match /businesses/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Customer orders live as a subcollection.
      // Customers are unauthenticated — order UUID acts as access control.
      match /customerOrders/{orderId} {
        // Business owner: full access
        allow read, write: if request.auth != null && request.auth.uid == uid;

        // Unauthenticated customers can:
        allow create: if request.auth == null;   // place a new order
        allow read:   if request.auth == null;   // track their order (by UUID)
        allow update: if request.auth == null;   // submit payment info
      }
    }

    // ── Public order portal data ────────────────────────────────────────────
    // Contains ONLY: business name, logo, currency, items, bank details.
    // No customer data, no invoices, no employee PINs, no financials.
    // Written by the authenticated business owner, read by anyone (customers).
    match /portals/{token} {
      allow read:  if true;                              // customers read products
      allow write: if request.auth != null               // only owner writes
                   && request.resource.data.businessUid == request.auth.uid;
    }

    // ── Plan / subscription info ────────────────────────────────────────────
    match /plan_info/{uid} {
      allow read, write: if request.auth != null &&
        (request.auth.uid == uid ||
         request.auth.token.email == "vaddever@gmail.com");
    }

    // ── Platform-wide admin config ──────────────────────────────────────────
    match /platform_config/{doc} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.token.email == "vaddever@gmail.com";
    }
  }
}
